(module
  (type $ft (func))
  (type $ct (cont $ft))
  (type $bt (func (result i32 (ref $ct))))
  (tag $yield (param i32))
  (tag $js (param anyref))
  (type $box (struct (field i32)))
  ;; generator body: yields 1,2,3; also throws+catches inside the continuation
  (func $gen
    (suspend $yield (i32.const 1))
    (block $h (result anyref)
      (try_table (catch $js $h) (throw $js (struct.new $box (i32.const 2))))
      unreachable)
    (ref.cast (ref $box)) (struct.get $box 0)
    (suspend $yield)
    (suspend $yield (i32.const 3)))
  (elem declare func $gen)
  (func (export "main") (result i32)
    (local $k (ref null $ct)) (local $sum i32)
    (local.set $k (cont.new $ct (ref.func $gen)))
    (loop $l
      (block $on_yield (type $bt)
        (resume $ct (on $yield $on_yield) (local.get $k))
        (return (local.get $sum)))
      (local.set $k)
      (local.set $sum (i32.add (local.get $sum)))
      (br $l))
    unreachable))
