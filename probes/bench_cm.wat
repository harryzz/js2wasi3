(component
  (core module $tbl (table (export "t") 1 funcref))
  (core instance $ti (instantiate $tbl))
  (core type $ft (func (param i32)))
  (core func $new (canon thread.new-indirect $ft (core table $ti "t")))
  (core func $sr (canon thread.suspend-then-resume))
  (core func $idx (canon thread.index))
  (core func $later (canon thread.resume-later))
  (core func $ret (canon task.return (result u32)))
  (core module $m
    (import "" "t" (table 1 funcref))
    (import "" "new" (func $new (param i32 i32) (result i32)))
    (import "" "sr" (func $sr (param i32) (result i32)))
    (import "" "idx" (func $idx (result i32)))
    (import "" "later" (func $later (param i32)))
    (import "" "ret" (func $ret (param i32)))
    (global $main (mut i32) (i32.const 0))
    (global $val (mut i32) (i32.const 0))
    (global $done (mut i32) (i32.const 0))
    (elem (i32.const 0) func $gen)
    ;; generator body as a CM thread: yields 10, 20, 30
    (func $gen (param i32)
      (local $i i32)
      (loop $l
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (global.set $val (i32.const 1))
        (drop (call $sr (global.get $main)))
        (br_if $l (i32.lt_u (local.get $i) (i32.const 1000000))))
      (global.set $done (i32.const 1))
      (call $later (global.get $main)))
    (func (export "run")
      (local $g i32) (local $sum i32)
      (global.set $main (call $idx))
      (local.set $g (call $new (i32.const 0) (i32.const 0)))
      (loop $l
        (drop (call $sr (local.get $g)))
        (if (i32.eqz (global.get $done))
          (then (local.set $sum (i32.add (local.get $sum) (global.get $val))) (br $l))))
      (call $ret (local.get $sum))))
  (core instance $i (instantiate $m (with "" (instance
    (export "t" (table $ti "t")) (export "new" (func $new)) (export "sr" (func $sr))
    (export "idx" (func $idx)) (export "later" (func $later)) (export "ret" (func $ret))))))
  (func (export "run") async (result u32) (canon lift (core func $i "run") async)))
