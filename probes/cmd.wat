(module
  (type $box (struct (field i32)))
  (tag $js (param anyref))
  (import "wasi:clocks/monotonic-clock@0.3.1" "[async-lower]wait-for" (func $wait_for (param i64) (result i32)))
  (import "wasi:cli/stdout@0.3.1" "write-via-stream" (func $write_via_stream (param i32) (result i32)))
  (import "wasi:cli/stdout@0.3.1" "[stream-new-0]write-via-stream" (func $stream_new (result i64)))
  (import "wasi:cli/stdout@0.3.1" "[async-lower][stream-write-0]write-via-stream" (func $stream_write (param i32 i32 i32) (result i32)))
  (import "wasi:cli/stdout@0.3.1" "[stream-drop-writable-0]write-via-stream" (func $stream_drop_w (param i32)))
  (import "$root" "[waitable-set-new]" (func $ws_new (result i32)))
  (import "$root" "[waitable-join]" (func $join (param i32 i32)))
  (import "$root" "[subtask-drop]" (func $subtask_drop (param i32)))
  (import "[export]wasi:cli/run@0.3.1" "[task-return]run" (func $task_return (param i32)))
  (memory (export "memory") 1)
  (data (i32.const 16) "hello from p3 (before timer)\n")   ;; 29 bytes
  (data (i32.const 64) "timer fired, GC+EH value = 7\n")  ;; 29 bytes
  (global $ws (mut i32) (i32.const 0))
  (global $w (mut i32) (i32.const 0))
  (global $phase (mut i32) (i32.const 0))

  ;; write a buffer; returns callback code (WAIT) if blocked, else -1 to continue
  (func $write (param $p i32) (param $n i32) (param $next i32) (result i32)
    (local $rc i32)
    (global.set $phase (local.get $next))
    (local.set $rc (call $stream_write (global.get $w) (local.get $p) (local.get $n)))
    (if (i32.eq (local.get $rc) (i32.const -1))
      (then
        (call $join (global.get $w) (global.get $ws))
        (return (i32.or (i32.const 2) (i32.shl (global.get $ws) (i32.const 4))))))
    (i32.const -1))

  (func $start_timer (result i32)
    (local $st i32)
    (global.set $phase (i32.const 2))
    (local.set $st (call $wait_for (i64.const 50000000)))
    (if (i32.eq (i32.and (local.get $st) (i32.const 15)) (i32.const 2))
      (then (return (call $after_timer))))
    (call $join (i32.shr_u (local.get $st) (i32.const 4)) (global.get $ws))
    (i32.or (i32.const 2) (i32.shl (global.get $ws) (i32.const 4))))

  ;; runs after the timer; uses a GC object thrown/caught via native EH
  (func $after_timer (result i32)
    (local $rc i32)
    (block $h (result anyref)
      (try_table (catch $js $h)
        (throw $js (struct.new $box (i32.const 7))))
      unreachable)
    (ref.cast (ref $box)) (struct.get $box 0)
    (if (i32.ne (i32.const 7)) (then unreachable))
    (local.set $rc (call $write (i32.const 64) (i32.const 29) (i32.const 3)))
    (if (i32.ne (local.get $rc) (i32.const -1)) (then (return (local.get $rc))))
    (call $finish))

  (func $finish (result i32)
    (call $stream_drop_w (global.get $w))
    (call $task_return (i32.const 0))
    (i32.const 0))

  (func (export "[async-lift]wasi:cli/run@0.3.1#run") (result i32)
    (local $s i64) (local $rc i32)
    (global.set $ws (call $ws_new))
    (local.set $s (call $stream_new))
    (global.set $w (i32.wrap_i64 (i64.shr_u (local.get $s) (i64.const 32))))
    (drop (call $write_via_stream (i32.wrap_i64 (local.get $s))))
    (local.set $rc (call $write (i32.const 16) (i32.const 29) (i32.const 1)))
    (if (i32.ne (local.get $rc) (i32.const -1)) (then (return (local.get $rc))))
    (call $start_timer))

  (func (export "[callback][async-lift]wasi:cli/run@0.3.1#run") (param $ev i32) (param $idx i32) (param $payload i32) (result i32)
    (if (i32.eq (global.get $phase) (i32.const 1)) (then (return (call $start_timer))))
    (if (i32.eq (global.get $phase) (i32.const 2))
      (then (call $subtask_drop (local.get $idx)) (return (call $after_timer))))
    (call $finish))

  (func (export "cabi_realloc") (param i32 i32 i32 i32) (result i32) unreachable)
)
