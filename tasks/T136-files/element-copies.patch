+    s.local_get(v).ref_cast_non_null(wasm_encoder::HeapType::Concrete(runtime::T_NUMBER)).struct_get(runtime::T_NUMBER, 0);
+    s.else_();
+    s.i64_const(array::HOLE).f64_reinterpret_i64();
+    s.end();
+    s.end();
