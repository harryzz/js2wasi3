package js2wasi3:brotli@0.1.0;

interface codecs {
    /// What node's native binding reports through `onerror(message, errno, code)`.
    record failure {
        message: string,
        errno: s32,
        code: string,
    }

    /// One call of `process`: how many input bytes were used and what was produced.
    record step {
        consumed: u32,
        output: list<u8>,
    }

    /// A Brotli stream: node's `BrotliEncoder` / `BrotliDecoder` handles.
    resource codec {
        /// `mode`: node's BROTLI_DECODE (8) or BROTLI_ENCODE (9). `params`: the init parameters by key (-1 = not given).
        create: static func(mode: u32, params: list<s32>) -> result<codec, failure>;
        /// One `write` of node's binding; `operation` is BROTLI_OPERATION_*.
        process: func(operation: u32, input: list<u8>, out-capacity: u32) -> result<step, failure>;
        reset: func() -> result<_, failure>;
    }
}

world helper {
    export codecs;
}
